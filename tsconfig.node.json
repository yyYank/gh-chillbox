{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
