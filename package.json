{
  "name": "gh-chillbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
